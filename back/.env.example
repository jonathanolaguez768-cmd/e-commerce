# Server
PORT=4000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:4321,http://localhost:5173

#Payment provider
MERCADOPAGO_ACCESS_TOKEN=your_access_token_here

# Model Context Protocol (MCP) Admin Secret
AS_MCP=your_admin_secret_here

# Email provider
EMAIL_PROVIDER=name_of_your_email_provider_here (nodemailer, resend)

GMAIL_USER=your_gmail_address_here
GMAIL_APP_PASSWORD=your_app_password_here

RESEND_API_KEY=your_resend_api_key_here
