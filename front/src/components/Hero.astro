<section class="hero">
  <div class="hero__content">
    <p class="hero__eyebrow">NUEVA COLECCIÓN</p>
    <h2>
      Encuentra<br/> tu propia<br/> manera de ser.
    </h2>
    <p class="hero__description">
      Explora nuestro catálogo y descubre productos hechos para acompañar tu estilo.
    </p>
  </div>
</section>

<style>
  .hero {
    width: min(1400px, calc(100% - 48px));
    min-height: 420px;
    margin: 32px auto 64px;
    display: flex;
    align-items: flex-end;
    background: linear-gradient(135deg, #ff6200 35%, #005df4 0%);
    color: #ffffff;
  }

  .hero__content {
    max-width: 720px;
    padding: 54px;
  }

  .hero__eyebrow {
    margin: 0 0 20px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .hero h2 {
    margin: 0;
    font-size: clamp(42px, 6vw, 76px);
    line-height: 0.95;
    letter-spacing: -0.055em;
    font-weight: 900;
  }

  .hero__description {
    max-width: 500px;
    margin: 28px 0 0;
    color: #d3cece;
    font-size: 19px;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .hero {
      width: calc(100% - 32px);
      min-height: 360px;
      margin-top: 16px;
    }

    .hero__content {
      padding: 32px;
    }

    .hero h2 {
      font-size: 46px;
    }
  }
</style>