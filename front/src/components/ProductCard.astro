
---
import type { Product } from '../types/product';
import './ProductCard.css';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const isOutOfStock = product.stock === 0;
---

<article class="product-card">
  {isOutOfStock ? (
    <div class="product-card__image-button">
      <div class="product-card__image-wrapper">
        <img
          src={product.image}
          alt={product.name}
          class="product-card__image"
          width="600"
          height="600"
          loading="lazy"
          decoding="async"
        />
        <span class="product-card__sold-out">AGOTADO</span>
      </div>
    </div>
  ) : (
    <a
      href={`/product/${product.id}`}
      class="product-card__image-button"
      aria-label={`Ver detalles de ${product.name}`}
    >
      <div class="product-card__image-wrapper">
        <img
          src={product.image}
          alt={product.name}
          class="product-card__image"
          width="600"
          height="600"
          loading="lazy"
          decoding="async"
        />
      </div>
    </a>
  )}

  <div class="product-card__info">
    <div>
      <h3>{product.name}</h3>
      <p>${product.price.toFixed(2)}</p>
    </div>

    {isOutOfStock ? (
      <span class="product-card__button product-card__button--disabled">
        Agotado
      </span>
    ) : (
      <a
        href={`/product/${product.id}`}
        class="product-card__button"
      >
        Ver producto
      </a>
    )}
  </div>
</article>
