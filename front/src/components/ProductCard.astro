---
import type { Product } from '../types/product';
import './ProductCard.css';

interface Props {
  product: Product;
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
const isOutOfStock = product.stock === 0;
---
<article class="product-card">
  <a href={isOutOfStock ? '#' : `/product/${product.id}`} class="product-card__image-button">
    <div class="product-card__image-wrapper">
      <img 
        src={product.image} 
        alt={product.name} 
        class="product-card__image"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
      />
      {isOutOfStock && <span class="product-card__sold-out">AGOTADO</span>}
    </div>
  </a>

  <div class="product-card__info">
    <div>
      <h3>{product.name}</h3>
      <p>${product.price.toFixed(2)}</p>
    </div>

    <a
      href={isOutOfStock ? '#' : `/product/${product.id}`}
      class="product-card__button"
      style={isOutOfStock ? 'pointer-events: none; opacity: 0.6;' : ''}
    >
      {isOutOfStock ? 'Agotado' : 'Ver producto'}
    </a>
  </div>
</article>