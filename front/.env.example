# Base URL of the backend API (no trailing slash)
PUBLIC_API_URL=http://localhost:4000

# Mercado Pago public key (safe to expose — used only by the browser SDK)
PUBLIC_MERCADOPAGO_KEY=your_public_key_here

# GraphQL endpoint � defaults to PUBLIC_API_URL/graphql if not set
PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
